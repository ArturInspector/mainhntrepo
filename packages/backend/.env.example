# Oracle wallet — must match the `oracle` address passed to adapter constructors
BACKEND_PRIVATE_KEY=0xYOUR_64_HEX_PRIVATE_KEY

# EVM node for submitting EAS attestations on-chain
EVM_RPC_URL=https://base-sepolia.example.com

# EAS contract address on the target chain
# Base Sepolia: 0x4200000000000000000000000000000000000021
# Optimism:     0x4200000000000000000000000000000000000021
EAS_ADDRESS=0x4200000000000000000000000000000000000021

# Schema UID — register once via EAS, matches contracts/src/interfaces/IEAS.sol
# Schema string: "bytes32 uniqueId,uint256 qualityScore"
EAS_SCHEMA_UID=0xYOUR_SCHEMA_UID

# Gitcoin Passport
GITCOIN_API_KEY=your_gitcoin_api_key
GITCOIN_SCORER_ID=your_scorer_id
GITCOIN_MIN_SCORE=20

# Server
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# Solana (frozen — not actively maintained)
# SOLANA_RPC_URL=https://api.devnet.solana.com
# SOLANA_ORACLE_PRIVATE_KEY=
